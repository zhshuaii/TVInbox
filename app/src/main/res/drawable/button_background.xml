<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#202B39" /><corners android:radius="6dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#2864AD" /><corners android:radius="6dp" /><stroke android:width="2dp" android:color="#FFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#2477DD" /><corners android:radius="6dp" /><stroke android:width="2dp" android:color="#A9D2FF" /></shape></item>
    <item><shape><solid android:color="#2B394C" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#3B4B60" /></shape></item>
</selector>
