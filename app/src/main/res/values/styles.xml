<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#101722</item>
        <item name="android:colorAccent">#4698FF</item>
        <item name="android:textColorPrimary">#F0F4FA</item>
        <item name="android:textColorSecondary">#ADB9CB</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">#F0F4FA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
